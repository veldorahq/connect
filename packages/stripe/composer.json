{
    "name": "veldora/connect-stripe",
    "version": "0.7.1",
    "description": "Stripe payment gateway integration for the Veldora PHP Framework",
    "type": "library",
    "license": "MIT",
    "keywords": ["veldora", "stripe", "payments", "connect"],
    "authors": [
        {
            "name": "Shahriyar Fahim",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "veldora/framework": "^0.6.0|^0.7.0",
        "stripe/stripe-php": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Veldora\\Connect\\Stripe\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "veldora": {
            "providers": [
                "Veldora\\Connect\\Stripe\\StripeServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Veldora\\Connect\\Stripe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
